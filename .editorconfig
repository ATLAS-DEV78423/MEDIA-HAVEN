root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{rs,toml}]
indent_size = 4

[*.md]
# Trailing whitespace is significant in Markdown (line breaks)
trim_trailing_whitespace = false

[*.{ps1,psm1,psd1}]
end_of_line = crlf
indent_size = 4

[*.{cs,json,yml,yaml}]
indent_size = 2

[Makefile]
indent_style = tab
