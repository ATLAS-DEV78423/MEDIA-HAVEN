# syntax=docker/dockerfile:1.7
FROM rust:1.99-bookworm AS builder

WORKDIR /src
# Copy manifests first for layer caching.
COPY Cargo.toml Cargo.lock ./
# A2 added apps/desktop/src-tauri as a workspace member. Cargo loads every
# member manifest AND resolves its declared lib target path even for
# `-p mediahaven-core`, so the manifest and a stub at src/lib.rs must exist in
# the context; the desktop crate's sources are never compiled here. Verified
# locally with `cargo metadata --no-deps` on a context containing only these
# two files plus crates/. .dockerignore un-ignores just these paths.
COPY apps/desktop/src-tauri/Cargo.toml apps/desktop/src-tauri/Cargo.toml
COPY infrastructure/containers/desktop-lib-stub.rs apps/desktop/src-tauri/src/lib.rs
COPY crates ./crates

RUN cargo build --release -p mediahaven-core

FROM debian:bookworm-slim AS runtime

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --system --gid 10001 mediahaven \
    && useradd --system --uid 10001 --gid mediahaven --home-dir /data --create-home mediahaven \
    && mkdir -p /var/lib/mediahaven/staging /var/cache/mediahaven \
    && chown -R 10001:10001 /var/lib/mediahaven /var/cache/mediahaven /data

COPY --from=builder /src/target/release/mediahaven-core /usr/local/bin/mediahaven-core

USER 10001
WORKDIR /data
ENV MEDIAHAVEN_BIND=0.0.0.0:8080 \
    MEDIAHAVEN_DATA_DIR=/data

EXPOSE 8080

HEALTHCHECK --interval=10s --timeout=3s --start-period=5s --retries=3 \
    CMD curl -fsS http://127.0.0.1:8080/healthz || exit 1

ENTRYPOINT ["/usr/local/bin/mediahaven-core"]
