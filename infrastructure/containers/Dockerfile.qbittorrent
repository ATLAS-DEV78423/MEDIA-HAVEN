# qBittorrent acquisition engine — minimal overlay on the pinned official
# headless image. The upstream entrypoint only chowns /config when it runs as
# root, but the service runs as UID 10003 (compose.yaml). Pre-chown the mount
# points: Docker copies image-directory ownership into a freshly created named
# volume, so the /config volume is writable without adding a toolchain.
# /downloads is now a host bind (${MEDIAHAVEN_DOWNLOAD_ROOT}); a build-time
# chown cannot affect it, so its writability is verified live instead.
FROM qbittorrentofficial/qbittorrent-nox@sha256:43b2d352cf76330a7ca34c7320b9b74227d6f31e662e0e123d0457206b09a7ea

USER root
RUN mkdir -p /config /downloads && chown -R 10003:10003 /config /downloads

# ADR-0018 / Task 3: the official entrypoint ignores QB_WEBUI_TOKEN, so the
# WebUI would have no operator-set password. Generate qBittorrent.conf at
# container start from the host-injected secret; nothing is baked into the
# image and no password is hardcoded. qB 5.3 verifies with PBKDF2-HMAC-SHA512
# (100000 iterations, 16-byte salt, 64-byte key) stored as the literal
# "<base64 salt>:<base64 key>" inside a @ByteArray value. python3 ships in the
# pinned base image; if a future base drops it this overlay needs a rebuild.
RUN cat > /usr/local/bin/mh-qb-init <<'MH_EOF'
#!/bin/sh
set -eu

# Fail closed: no injected secret means no WebUI password, so never start.
: "${QB_WEBUI_TOKEN:?host-generated WebUI password required}"

conf=/config/qBittorrent/config/qBittorrent.conf
mkdir -p "$(dirname "$conf")"

python3 - "$conf" <<'PY'
import base64
import hashlib
import os
import sys

password = os.environ["QB_WEBUI_TOKEN"].encode("utf-8")
path = sys.argv[1]
salt = os.urandom(16)
key = hashlib.pbkdf2_hmac("sha512", password, salt, 100000, dklen=64)
secret = base64.b64encode(salt).decode() + ":" + base64.b64encode(key).decode()
config = (
    "[BitTorrent]\n"
    "Session\\DefaultSavePath=/downloads\n"
    "Session\\TempPath=/downloads/temp\n"
    "Session\\TempPathEnabled=true\n"
    "[Meta]\n"
    "MigrationVersion=9999\n"
    "[WebUI]\n"
    "Port=8080\n"
    'Password_PBKDF2="@ByteArray(' + secret + ')"\n'
)
with open(path, "w", encoding="utf-8") as handle:
    handle.write(config)
PY

exec /entrypoint.sh "$@"
MH_EOF
RUN chmod 0755 /usr/local/bin/mh-qb-init

USER 10003:10003
ENTRYPOINT ["/usr/local/bin/mh-qb-init"]
